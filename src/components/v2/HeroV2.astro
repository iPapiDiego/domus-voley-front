---
// HeroV2.astro - Dynamic Matchday Hero with Real Domus Instagram Info & Stats
---

<section class="relative min-h-screen flex items-center justify-center overflow-x-clip overflow-y-hidden pt-28 sm:pt-36 pb-16 sm:pb-20 lg:pt-44 lg:pb-28 bg-[#03131e] w-full max-w-full">
  <!-- Background Video with Ocean Navy Scrim Layers -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <video 
      data-hero-video
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      class="w-full h-full object-cover object-center scale-100 sm:scale-105 filter brightness-70 contrast-110"
      poster="/images/hero-volley.jpg"
    >
      <source src="/videos/hero-volleyball.webm" type="video/webm" />
    </video>

    <!-- Deep Ocean Navy Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#03131e] via-[#03131e]/75 to-[#03131e]/60"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[#03131e]/50 to-[#03131e]/90"></div>
    
    <!-- Sports subtle scanline overlay -->
    <div class="absolute inset-0 opacity-10 pointer-events-none broadcast-scanlines"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center min-w-0">
    
    <!-- Live Sports Marquee Ticker in Teal/Navy -->
    <div class="w-full max-w-3xl mx-auto mb-5 sm:mb-6 py-1.5 px-3 sm:px-4 rounded-full bg-[#041a29]/80 border border-teal-500/30 backdrop-blur-md overflow-hidden shadow-lg shadow-teal-950/40 min-w-0">
      <div class="flex items-center justify-center gap-2 sm:gap-3 text-[11px] sm:text-xs font-semibold text-slate-300 min-w-0 w-full overflow-hidden">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-teal-500 text-slate-950 font-bold text-[9px] sm:text-[10px] uppercase tracking-wider animate-pulse shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-950"></span>
          EN VIVO
        </span>
        <span class="truncate min-w-0 block">
          Temporada 2026: Sedes Fanning & Joseph and Mary • Mar, Jue, Sáb
        </span>
      </div>
    </div>

    <!-- Hero Badge with Real League & Instagram Link -->
    <a 
      href="https://www.instagram.com/domus.voleibol.club/"
      target="_blank"
      rel="noopener noreferrer"
      data-hero-badge 
      class="inline-flex items-center max-w-full gap-2 px-3 py-1 sm:px-4 sm:py-1.5 rounded-full bg-teal-500/15 hover:bg-teal-500/25 border border-teal-400/30 hover:border-teal-400/60 text-teal-300 text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6 backdrop-blur-sm shadow-sm shadow-teal-500/10 transition-all cursor-pointer group min-w-0"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping shrink-0"></span>
      <span class="truncate min-w-0">DOMUS VOLEIBOL CLUB • LIGA DE MIRAFLORES 🔥</span>
      <span class="text-slate-400 group-hover:text-teal-200 text-xs hidden sm:inline shrink-0">↗</span>
    </a>

    <!-- Main Title with Athletic Styling -->
    <h1 
      data-hero-title 
      class="font-athletic text-3xl sm:text-5xl md:text-6xl lg:text-8xl font-black text-white tracking-tight uppercase leading-[1.05] sm:leading-[0.95] w-full max-w-5xl mb-5 sm:mb-6 drop-shadow-2xl break-words"
    >
      FORJAMOS <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-teal-400 to-cyan-200">CAMPEONES</span> DENTRO Y FUERA DE LA CANCHA
    </h1>

    <!-- Subtitle with Real Info from Bio -->
    <p 
      data-hero-subtitle 
      class="font-sans text-sm sm:text-lg md:text-xl text-slate-300 w-full max-w-3xl mb-8 sm:mb-10 leading-relaxed font-normal"
    >
      Voleibol formativo y competitivo en Jesús María. Entrenadores certificados COPEV e internacionales, preparación física de alto impacto y participación en torneos federados.
    </p>

    <!-- Call to Actions -->
    <div 
      data-hero-actions 
      class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto max-w-full mb-10 sm:mb-14"
    >
      <!-- Primary Action: Open Modal -->
      <button 
        type="button"
        data-open-enroll-modal
        data-preset-category="Sub 15 (Colegio Fanning)"
        class="w-full sm:w-auto max-w-full px-5 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-400 hover:from-teal-400 hover:to-emerald-300 text-slate-950 font-sans font-black text-sm sm:text-base uppercase tracking-wider transition-all duration-300 shadow-xl shadow-teal-500/30 hover:shadow-teal-500/50 hover:-translate-y-0.5 cursor-pointer active:scale-95 flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-teal-400/50"
      >
        <span class="truncate">Agendar Clase de Prueba Gratis</span>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-slate-950 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>

      <!-- Secondary Action: Jump to Tactical Court -->
      <a 
        href="#tactica" 
        class="w-full sm:w-auto max-w-full px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl border-2 border-teal-500/40 hover:border-teal-300 bg-[#051c2c]/80 hover:bg-[#07253a]/90 text-teal-100 font-sans font-semibold text-sm sm:text-base transition-all duration-300 backdrop-blur-sm cursor-pointer flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-teal-500/30"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="truncate">Ver Pizarra Táctica 3D</span>
      </a>
    </div>

    <!-- Quick Stats Grid Bar in Ocean Navy / Teal with REAL Instagram metrics -->
    <div 
      data-hero-stats 
      class="w-full max-w-4xl grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-4 p-2.5 sm:p-6 rounded-2xl bg-[#051c2c]/90 border border-teal-500/20 backdrop-blur-md shadow-2xl"
    >
      <div class="flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl bg-white/[0.02] border border-white/5 min-w-0">
        <span class="font-athletic text-2xl sm:text-4xl md:text-5xl font-black text-teal-400 tracking-tight truncate max-w-full" data-count-target="8600" data-count-suffix="+">
          8.6K+
        </span>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-300 uppercase tracking-wider font-sans mt-0.5 text-center truncate max-w-full">
          Comunidad IG
        </span>
      </div>

      <div class="flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl bg-white/[0.02] border border-white/5 min-w-0">
        <span class="font-athletic text-2xl sm:text-4xl md:text-5xl font-black text-cyan-300 tracking-tight truncate max-w-full">
          COPEV
        </span>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-300 uppercase tracking-wider font-sans mt-0.5 text-center truncate max-w-full">
          Staff Federado
        </span>
      </div>

      <div class="flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl bg-white/[0.02] border border-white/5 min-w-0">
        <span class="font-athletic text-2xl sm:text-4xl md:text-5xl font-black text-amber-400 tracking-tight truncate max-w-full">
          2 SEDES
        </span>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-300 uppercase tracking-wider font-sans mt-0.5 text-center truncate max-w-full">
          Jesús María
        </span>
      </div>

      <div class="flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl bg-white/[0.02] border border-white/5 min-w-0">
        <span class="font-athletic text-2xl sm:text-4xl md:text-5xl font-black text-emerald-400 tracking-tight truncate max-w-full">
          GRATIS
        </span>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-300 uppercase tracking-wider font-sans mt-0.5 text-center truncate max-w-full">
          1ra Clase Prueba
        </span>
      </div>
    </div>

  </div>

  <!-- Bottom Floating Media Controls (Left positioned to avoid WhatsApp button) -->
  <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-8 z-20 flex items-center gap-2">
    <!-- Play/Pause Toggle -->
    <button 
      type="button"
      data-video-toggle-play
      aria-label="Pausar video de fondo"
      class="p-2 sm:p-2.5 rounded-full bg-[#051c2c]/80 hover:bg-[#07253a] text-teal-300 hover:text-white border border-teal-500/20 backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-teal-400 shadow-lg"
      title="Reproducir / Pausar video"
    >
      <!-- Pause Icon -->
      <svg data-icon-pause class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
      </svg>
      <!-- Play Icon -->
      <svg data-icon-play class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>

    <!-- Sound Toggle -->
    <button 
      type="button"
      data-video-toggle-sound
      aria-label="Activar sonido"
      class="p-2 sm:p-2.5 rounded-full bg-[#051c2c]/80 hover:bg-[#07253a] text-teal-300 hover:text-white border border-teal-500/20 backdrop-blur-md transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-teal-400 shadow-lg"
      title="Activar / Desactivar audio"
    >
      <!-- Muted (Sound Off) Icon -->
      <svg data-icon-sound-off class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
      </svg>
      <!-- Sound On Icon -->
      <svg data-icon-sound-on class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
    </button>
  </div>
</section>
