---
// ModalV2.astro - Free Trial Class Reservation Modal with Official Domus Schedules
---

<div 
  data-enroll-modal-v2 
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-v2-title"
>
  <div class="relative w-full max-w-lg rounded-3xl bg-[#041a29] border-2 border-teal-500/30 p-5 sm:p-8 shadow-2xl text-left font-sans max-h-[92vh] overflow-y-auto">
    
    <!-- Close Button -->
    <button 
      type="button" 
      data-close-enroll-modal
      aria-label="Cerrar modal de reserva"
      class="absolute top-4 right-4 sm:top-5 sm:right-5 p-2 rounded-full bg-white/5 hover:bg-teal-500 hover:text-slate-950 text-slate-300 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-teal-400"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="mb-5 sm:mb-6 pr-8 sm:pr-0">
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-teal-500/20 text-teal-300 text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider mb-2 border border-teal-500/40">
        <span>1RA SESIÓN DE EVALUACIÓN 100% GRATIS</span>
      </div>
      <h3 id="modal-v2-title" class="font-athletic text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
        RESERVA TU CLASE DE PRUEBA
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
        Sedes: Colegio Fanning & Colegio Joseph and Mary (Av. Arnaldo Márquez 551, Jesús María).
      </p>
    </div>

    <!-- Enrollment Form -->
    <form data-enroll-form class="space-y-4">
      <div>
        <label for="v2-nombre" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
          Nombre Completo del Alumno / Apoderado *
        </label>
        <input 
          type="text" 
          id="v2-nombre" 
          name="nombre" 
          required 
          placeholder="Ej: Luciana Morales / Pedro Morales" 
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-2 focus:ring-teal-400/20 transition-all placeholder:text-slate-500"
        />
      </div>

      <div>
        <label for="v2-telefono" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
          Número de WhatsApp / Teléfono *
        </label>
        <input 
          type="tel" 
          id="v2-telefono" 
          name="telefono" 
          required 
          placeholder="Ej: 979 833 360" 
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-2 focus:ring-teal-400/20 transition-all placeholder:text-slate-500"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="v2-categoria" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
            Categoría Oficial *
          </label>
          <select 
            id="v2-categoria" 
            name="categoria" 
            class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-2 focus:ring-teal-400/20 transition-all"
          >
            <option value="Sub 11 - Col. Joseph and Mary (4:30 - 6:00 pm)">Sub 11 - Joseph and Mary (4:30 - 6:00 pm)</option>
            <option value="Sub 12 - Col. Joseph and Mary (6:00 - 7:30 pm)">Sub 12 - Joseph and Mary (6:00 - 7:30 pm)</option>
            <option value="Sub 15 - Col. Fanning (6:00 - 7:30 pm)" selected>Sub 15 - Col. Fanning (6:00 - 7:30 pm)</option>
            <option value="Adultos Libre - Col. Fanning / Joseph and Mary (7:30 - 9:00 pm)">Adultos Libre (7:30 - 9:00 pm)</option>
            <option value="Equipo Competencia - Liga de Miraflores">Competencia - Liga Miraflores</option>
          </select>
        </div>

        <div>
          <label for="v2-horario" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
            Días de Entrenamiento
          </label>
          <select 
            id="v2-horario" 
            name="horario" 
            class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-2 focus:ring-teal-400/20 transition-all"
          >
            <option value="Martes, Jueves y Sábado (Oficial)">Martes, Jueves y Sábado (Oficial)</option>
            <option value="Consultar disponibilidad especial">Consultar disponibilidad</option>
          </select>
        </div>
      </div>

      <div>
        <label for="v2-mensaje" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
          Comentario adicional (opcional)
        </label>
        <textarea 
          id="v2-mensaje" 
          name="mensaje" 
          rows="2" 
          placeholder="¿Tiene experiencia previa? ¿Alguna duda específica?" 
          class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-2 focus:ring-teal-400/20 transition-all placeholder:text-slate-500 resize-none"
        ></textarea>
      </div>

      <button 
        type="submit" 
        class="w-full py-4 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-400 hover:from-teal-400 hover:to-emerald-300 text-slate-950 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xl shadow-teal-500/25 cursor-pointer flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-teal-400/50"
      >
        <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Confirmar Reserva por WhatsApp</span>
      </button>

      <p class="text-[11px] text-center text-slate-400 font-sans">
        🔒 Tus datos son confidenciales y solo se usarán para coordinar tu clase de prueba gratuita.
      </p>
    </form>

  </div>
</div>
