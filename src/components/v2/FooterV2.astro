---
// FooterV2.astro - Official Sports Club Footer for Domus Voley V2 Pro
---

<footer class="bg-[#020a12] border-t border-teal-500/15 text-slate-400 font-sans pt-12 sm:pt-16 pb-10 sm:pb-12 px-4 sm:px-6 lg:px-8 relative">
  <div class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-10 pb-8 sm:pb-12 border-b border-teal-500/15">
      
      <!-- Brand & Mission (5 cols) -->
      <div class="lg:col-span-5 space-y-4 text-center sm:text-left">
        <a href="/v2" class="flex items-center justify-center sm:justify-start gap-3.5 group cursor-pointer inline-flex">
          <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-full p-0.5 ring-2 ring-teal-500/30 bg-[#03131e] group-hover:ring-teal-400 transition-all shadow-md shadow-teal-500/15 shrink-0">
            <img 
              src="/images/logo.png" 
              alt="Domus Voleibol Club Escudo" 
              class="w-full h-full object-cover rounded-full"
              width="48"
              height="48"
              loading="lazy"
            />
          </div>
          <div class="text-left">
            <span class="font-athletic text-2xl font-black text-white block group-hover:text-teal-300 transition-colors">
              DOMUS <span class="text-teal-400">VOLEY</span>
            </span>
            <span class="text-[11px] sm:text-xs text-slate-400 tracking-wider uppercase font-medium">
              Pasión, Técnica y Disciplina • Jesús María
            </span>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm mx-auto sm:mx-0">
          Academia formativa y competitiva de voleibol en Lima, Perú. Afiliados a la Liga de Miraflores (FPV / IPD). Formamos atletas integrales con entrenadores certificados COPEV e internacionales.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center justify-center sm:justify-start gap-3 pt-2">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/domus.voleibol.club/?hl=es" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Instagram Oficial de Domus Voleibol Club"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-gradient-to-tr hover:from-teal-500 hover:to-cyan-400 hover:text-slate-950 text-white flex items-center justify-center transition-all duration-300 cursor-pointer group"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689-.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- WhatsApp Primary -->
          <a 
            href="https://wa.me/51979833360?text=Hola%20Domus%20Voley,%20quiero%20informaci%C3%B3n" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="WhatsApp Principal Domus Voleibol Club"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-emerald-500 hover:text-slate-950 text-white flex items-center justify-center transition-all duration-300 cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation (3 cols) -->
      <div class="lg:col-span-3 space-y-3 text-center sm:text-left">
        <h4 class="text-xs font-black uppercase tracking-widest text-white">
          Navegación Rápida
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="#tactica" class="hover:text-teal-400 transition-colors">Pizarra Táctica 2.5D</a></li>
          <li><a href="#experiencia" class="hover:text-teal-400 transition-colors">Experiencia Domus</a></li>
          <li><a href="#categorias" class="hover:text-teal-400 transition-colors">Categorías & Horarios</a></li>
          <li><a href="#cotizador" class="hover:text-teal-400 transition-colors">Calculadora de Matrícula</a></li>
          <li><a href="#galeria" class="hover:text-teal-400 transition-colors">Galería Fotográfica</a></li>
          <li><a href="#instagram-feed" class="hover:text-teal-400 transition-colors">Comunidad Instagram</a></li>
          <li><a href="#faq" class="hover:text-teal-400 transition-colors">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Sede & Contacto (4 cols) -->
      <div class="lg:col-span-4 space-y-3 text-center sm:text-left">
        <h4 class="text-xs font-black uppercase tracking-widest text-white">
          Sedes & Contacto
        </h4>
        <div class="space-y-2.5 text-xs sm:text-sm text-slate-300">
          <p class="flex items-start justify-center sm:justify-start gap-2.5">
            <svg class="w-4 h-4 text-teal-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Colegio Fanning & Colegio Joseph and Mary • Av. Arnaldo Márquez 551, Jesús María, Lima</span>
          </p>
          <p class="flex items-center justify-center sm:justify-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>979 833 360 / 926 612 867 (WhatsApp Oficial)</span>
          </p>
          <p class="flex items-center justify-center sm:justify-start gap-2.5">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
            </svg>
            <a href="https://www.instagram.com/domus.voleibol.club/" target="_blank" rel="noopener noreferrer" class="text-teal-400 hover:underline">@domus.voleibol.club (8.6K+ seguidores)</a>
          </p>
          <p class="flex items-center justify-center sm:justify-start gap-2.5">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Martes, Jueves y Sábados (Tardes y Noches)</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 sm:pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-xs text-slate-400 text-center sm:text-left">
      <div>
        © 2026 Domus Voleibol Club (DVC). Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/" class="text-slate-400 hover:text-teal-300 underline cursor-pointer">
          Ver Landing Versión 1 Clásica
        </a>
        <span>•</span>
        <span class="text-slate-400">Astro Puro + Tailwind CSS + GSAP</span>
      </div>
    </div>

  </div>
</footer>
