---
// Modal.astro - Interactive Enrollment & WhatsApp Lead Modal
---

<div 
  id="enroll-modal" 
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div 
    id="modal-backdrop" 
    class="fixed inset-0 bg-[#020b12]/80 backdrop-blur-md transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Modal Panel -->
  <div 
    id="modal-panel" 
    class="relative w-full max-w-lg rounded-3xl bg-[#091e2c] border-2 border-teal-500/40 p-6 sm:p-8 shadow-2xl shadow-black/80 transition-all duration-300 transform opacity-0 scale-95 translate-y-4 z-10 my-8"
  >
    <!-- Close Button -->
    <button 
      type="button" 
      class="close-modal-btn absolute top-5 right-5 w-9 h-9 rounded-full bg-[#05131d] border border-teal-500/30 text-slate-400 hover:text-white hover:border-teal-400 flex items-center justify-center transition-colors cursor-pointer"
      aria-label="Cerrar modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center gap-3.5 mb-6">
      <div class="w-12 h-12 rounded-full overflow-hidden border border-teal-400 p-0.5 bg-[#05131d] shrink-0">
        <img src="/images/logo.png" alt="Domus Logo" class="w-full h-full object-cover rounded-full" />
      </div>
      <div>
        <h3 id="modal-title" class="font-display text-2xl sm:text-3xl font-bold uppercase text-white leading-tight">
          Inscripción & Clase de Prueba
        </h3>
        <p class="text-xs text-teal-400">Domus Voleibol Club • Sede Jesús María</p>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-300 mb-6">
      Completa tus datos y te conectaremos directamente con nuestro equipo de admisiones por WhatsApp para confirmar horarios y separar tu vacante.
    </p>

    <!-- Form -->
    <form id="enroll-form" class="space-y-4">
      
      <div>
        <label for="modal-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
          Nombre Completo *
        </label>
        <input 
          type="text" 
          id="modal-name" 
          required 
          placeholder="Ej: Luciana Morales" 
          class="w-full px-4 py-3 rounded-xl bg-[#05131d] border border-teal-500/30 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-400 transition-colors"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="modal-age" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            Edad del Alumno/a *
          </label>
          <input 
            type="number" 
            id="modal-age" 
            required 
            min="5" 
            max="80" 
            placeholder="Ej: 14" 
            class="w-full px-4 py-3 rounded-xl bg-[#05131d] border border-teal-500/30 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-400 transition-colors"
          />
        </div>

        <div>
          <label for="modal-category" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            Categoría *
          </label>
          <select 
            id="modal-category" 
            required 
            class="w-full px-4 py-3 rounded-xl bg-[#05131d] border border-teal-500/30 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-400 transition-colors"
          >
            <option value="Semillero (6 a 12 años)">Semillero (6 a 12 años)</option>
            <option value="Juvenil (13 a 17 años)">Menores / Juvenil (13 a 17 años)</option>
            <option value="Mayores / Adultos (18+ años)">Mayores / Adultos (18+ años)</option>
            <option value="Competitivo / Avanzado">Competitivo / Avanzado</option>
          </select>
        </div>
      </div>

      <div>
        <label for="modal-shift" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
          Turno de Preferencia
        </label>
        <select 
          id="modal-shift" 
          class="w-full px-4 py-3 rounded-xl bg-[#05131d] border border-teal-500/30 text-white text-sm focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-400 transition-colors"
        >
          <option value="Lunes, Miércoles y Viernes (Tarde / Noche)">Lunes, Miércoles y Viernes (Tarde / Noche)</option>
          <option value="Martes y Jueves (Tarde / Noche)">Martes y Jueves (Tarde / Noche)</option>
          <option value="Sábados y Domingos (Mañana)">Sábados y Domingos (Mañana)</option>
        </select>
      </div>

      <div>
        <label for="modal-notes" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
          Consulta o Experiencia Previa (Opcional)
        </label>
        <textarea 
          id="modal-notes" 
          rows="2" 
          placeholder="Ej: Ya jugué en mi colegio / Es mi primera vez practicando vóley..."
          class="w-full px-4 py-2.5 rounded-xl bg-[#05131d] border border-teal-500/30 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-400 transition-colors resize-none"
        ></textarea>
      </div>

      <div class="pt-2">
        <button 
          type="submit" 
          class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-black text-sm uppercase tracking-wider shadow-lg shadow-emerald-500/30 hover:shadow-emerald-400/50 transition-all flex items-center justify-center gap-2.5 cursor-pointer"
        >
          <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Enviar Mensaje a WhatsApp (+51 979 833 360)</span>
        </button>
      </div>

    </form>
  </div>
</div>
