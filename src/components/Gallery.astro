---
// Gallery.astro - High-Energy Volleyball Action Gallery with Lightbox Triggers & Instagram Hub
---

<section id="galeria" class="py-20 md:py-32 relative bg-[#040f18] overflow-hidden">
  
  <!-- Ambient background glow -->
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-teal-500/10 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="section-header text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-md bg-teal-500/15 border-l-2 border-teal-400 text-teal-300 text-xs font-black uppercase tracking-widest mb-3">
        // GALERÍA EN ACCIÓN
      </div>
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-black uppercase text-white leading-tight mb-5">
        El Vóley se Vive <span class="text-gradient-neon">Punto a Punto</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Haz clic en cualquier imagen para ver la intensidad de los entrenamientos y partidos de Domus Voleibol Club.
      </p>
    </div>

    <!-- Sports Photo Masonry / Grid -->
    <div class="gallery-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Photo 1: Big Feature Spike -->
      <div 
        data-gallery-photo
        data-img-src="/images/spiker-net.jpg"
        data-img-title="Remate de Ataque sobre la Red"
        data-img-sub="Entrenamiento intensivo de carrera de aproximación y batida de salto"
        class="gallery-item group relative rounded-3xl overflow-hidden border-2 border-teal-500/30 aspect-[4/3] sm:col-span-2 lg:col-span-2 cursor-pointer shadow-xl hover:border-teal-300 transition-all duration-300"
      >
        <img 
          src="/images/spiker-net.jpg" 
          alt="Ataque sobre la red en Domus Voley" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-black/40 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
        <div class="absolute top-4 left-4">
          <span class="px-3 py-1 rounded-md bg-teal-400 text-[#040f18] font-black text-xs uppercase tracking-wider shadow">
            POTENCIA & SALTO
          </span>
        </div>
        <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between">
          <div>
            <h3 class="font-display text-2xl sm:text-3xl font-black uppercase text-white drop-shadow">
              Ataque y muñequeo ofensivo
            </h3>
            <p class="text-xs sm:text-sm text-teal-300 font-semibold">Técnica de superación de doble bloqueo</p>
          </div>
          <span class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md text-white flex items-center justify-center group-hover:bg-teal-400 group-hover:text-[#040f18] transition-colors shrink-0">
            🔍
          </span>
        </div>
      </div>

      <!-- Photo 2: Instagram Showcase Card -->
      <div class="gallery-item rounded-3xl p-8 bg-gradient-to-br from-[#0a2336] via-[#061926] to-[#040f18] border-2 border-teal-400/50 flex flex-col justify-between shadow-2xl relative overflow-hidden group">
        <div class="absolute -top-10 -right-10 w-44 h-44 bg-gradient-to-br from-pink-500/25 to-purple-600/25 rounded-full blur-2xl"></div>

        <div>
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-400 via-rose-500 to-purple-600 p-0.5 mb-5 flex items-center justify-center shadow-lg group-hover:rotate-6 transition-transform">
            <div class="w-full h-full bg-[#040f18] rounded-2xl flex items-center justify-center text-white">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
              </svg>
            </div>
          </div>
          <span class="text-[10px] uppercase font-black text-teal-400 tracking-widest block mb-1">
            RED SOCIAL OFICIAL
          </span>
          <h3 class="font-display text-2xl font-bold uppercase text-white mb-2">
            @domus.voleibol.club
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Conoce a nuestras jugadoras y jugadores, mira historias diarias de las clases en el Colegio Fanning y noticias de torneos.
          </p>
        </div>

        <a 
          href="https://www.instagram.com/domus.voleibol.club/?hl=es" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-pink-500 via-rose-500 to-purple-600 text-white font-black text-xs uppercase tracking-wider text-center shadow-lg shadow-pink-500/25 hover:shadow-pink-500/40 hover:scale-[1.02] transition-all flex items-center justify-center gap-2"
        >
          <span>Seguir en Instagram</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Photo 3: Saque en Suspensión -->
      <div 
        data-gallery-photo
        data-img-src="/images/jump-serve.jpg"
        data-img-title="Saque en Suspensión"
        data-img-sub="Lanzamiento preciso y golpeo en el punto más alto del salto"
        class="gallery-item group relative rounded-3xl overflow-hidden border border-teal-500/30 aspect-[4/3] cursor-pointer hover:border-teal-300 transition-all"
      >
        <img 
          src="/images/jump-serve.jpg" 
          alt="Saque potente de voleibol" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-black/40 to-transparent opacity-80"></div>
        <div class="absolute top-4 left-4">
          <span class="px-2.5 py-0.5 rounded bg-sky-500 text-white font-black text-[10px] uppercase">
            SAQUE FLOTANTE
          </span>
        </div>
        <div class="absolute bottom-4 left-4 right-4">
          <p class="font-display text-xl font-bold text-white uppercase">Precisión al Servicio</p>
          <p class="text-xs text-teal-300">Desestabilización de recepción rival</p>
        </div>
      </div>

      <!-- Photo 4: Defensa Acrobática Líbero -->
      <div 
        data-gallery-photo
        data-img-src="/images/libero-defense.jpg"
        data-img-title="Defensa Acrobática de Campo"
        data-img-sub="Lectura de trayectoria, zambullida y recuperación de balones difíciles"
        class="gallery-item group relative rounded-3xl overflow-hidden border border-teal-500/30 aspect-[4/3] cursor-pointer hover:border-teal-300 transition-all"
      >
        <img 
          src="/images/libero-defense.jpg" 
          alt="Defensa de campo libero" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-black/40 to-transparent opacity-80"></div>
        <div class="absolute top-4 left-4">
          <span class="px-2.5 py-0.5 rounded bg-emerald-500 text-[#040f18] font-black text-[10px] uppercase">
            DEFENSA PURA
          </span>
        </div>
        <div class="absolute bottom-4 left-4 right-4">
          <p class="font-display text-xl font-bold text-white uppercase">Balón Siempre Vivo</p>
          <p class="text-xs text-teal-300">Reflejos y entrega en zaguero</p>
        </div>
      </div>

      <!-- Photo 5: Team Huddle -->
      <div 
        data-gallery-photo
        data-img-src="/images/team-huddle.jpg"
        data-img-title="Arenga & Confraternidad en Equipo"
        data-img-sub="La unión de grupo antes de ingresar a la cancha a darlo todo"
        class="gallery-item group relative rounded-3xl overflow-hidden border border-teal-500/30 aspect-[4/3] cursor-pointer hover:border-teal-300 transition-all"
      >
        <img 
          src="/images/team-huddle.jpg" 
          alt="Arenga en equipo Domus Voleibol" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-black/40 to-transparent opacity-80"></div>
        <div class="absolute top-4 left-4">
          <span class="px-2.5 py-0.5 rounded bg-amber-400 text-slate-900 font-black text-[10px] uppercase">
            ESPÍRITU DVC
          </span>
        </div>
        <div class="absolute bottom-4 left-4 right-4">
          <p class="font-display text-xl font-bold text-white uppercase">Unión & Arenga</p>
          <p class="text-xs text-teal-300">Jugamos por el compañero al lado</p>
        </div>
      </div>

      <!-- Photo 6: Match Point -->
      <div 
        data-gallery-photo
        data-img-src="/images/match-point.jpg"
        data-img-title="Punto Decisivo de Partido"
        data-img-sub="La adrenalina de cerrar el set en torneos locales"
        class="gallery-item group relative rounded-3xl overflow-hidden border border-teal-500/30 aspect-[4/3] cursor-pointer hover:border-teal-300 transition-all"
      >
        <img 
          src="/images/match-point.jpg" 
          alt="Punto decisivo voleibol" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-black/40 to-transparent opacity-80"></div>
        <div class="absolute top-4 left-4">
          <span class="px-2.5 py-0.5 rounded bg-rose-500 text-white font-black text-[10px] uppercase">
            ALTA INTENSIDAD
          </span>
        </div>
        <div class="absolute bottom-4 left-4 right-4">
          <p class="font-display text-xl font-bold text-white uppercase">Partidos en Vivo</p>
          <p class="text-xs text-teal-300">Emoción de competencia real</p>
        </div>
      </div>

    </div>

  </div>

  <!-- PHOTO LIGHTBOX MODAL COMPONENT (Hidden by default, triggered by JS) -->
  <div 
    id="photo-lightbox" 
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/90 backdrop-blur-xl transition-opacity duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
  >
    <div id="lightbox-backdrop" class="absolute inset-0"></div>

    <div class="relative z-10 max-w-4xl w-full flex flex-col items-center">
      <button 
        id="lightbox-close" 
        type="button" 
        class="self-end mb-3 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 cursor-pointer border border-white/20"
        aria-label="Cerrar visor de foto"
      >
        <span>Cerrar (ESC)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="relative w-full rounded-2xl overflow-hidden border-2 border-teal-400 shadow-2xl max-h-[75vh] flex items-center justify-center bg-black">
        <img 
          id="lightbox-img" 
          src="" 
          alt="Foto ampliada Domus Voley" 
          class="max-h-[75vh] w-auto max-w-full object-contain"
        />
      </div>

      <div class="mt-4 text-center">
        <h4 id="lightbox-title" class="font-display text-2xl sm:text-3xl font-bold text-white uppercase tracking-wide"></h4>
        <p id="lightbox-sub" class="text-xs sm:text-sm text-teal-300"></p>
      </div>
    </div>
  </div>

</section>
