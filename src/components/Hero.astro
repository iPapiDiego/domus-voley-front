---
// Hero.astro - Athletic Sports Hero with Looping Video Background & Match HUD
---

<section id="inicio" class="relative min-h-[95vh] pt-28 pb-16 md:pt-36 md:pb-24 flex flex-col justify-between overflow-hidden bg-[#040f18]">
  
  <!-- BACKGROUND VIDEO LAYER -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <video 
      id="hero-bg-video" 
      autoplay 
      loop 
      muted 
      playsinline 
      poster="/images/hero-volley.jpg" 
      class="w-full h-full object-cover object-center scale-105 filter brightness-75 contrast-125 transition-opacity duration-700 opacity-45"
    >
      <source src="/videos/hero-volleyball.webm" type="video/webm" />
    </video>

    <!-- Athletic Gradient & Scanline Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#040f18] via-[#040f18]/70 to-[#040f18]/90"></div>
    <div class="absolute inset-0 bg-radial-court opacity-90 pointer-events-none"></div>
    <div class="absolute inset-0 broadcast-scanlines opacity-15 pointer-events-none"></div>
    <div class="absolute inset-0 bg-court-lines opacity-20 pointer-events-none"></div>
  </div>

  <!-- Video Status / Interactive Sport Control -->
  <div class="absolute top-24 right-4 sm:right-8 z-20 hidden sm:flex items-center gap-3">
    <div class="px-3.5 py-1.5 rounded-full card-glass border border-teal-500/40 text-[11px] font-bold tracking-wider flex items-center gap-2 text-teal-300">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span id="video-status-text" class="uppercase">CANCHA EN VIVO</span>
    </div>
    <button 
      id="video-toggle-btn"
      type="button"
      class="p-2 rounded-full card-glass border border-teal-500/30 text-teal-300 hover:text-white hover:border-teal-400 transition-colors cursor-pointer"
      aria-label="Pausar o reanudar video de fondo"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </button>
  </div>

  <!-- MAIN HERO CONTENT -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full my-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Athletic Actions -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        
        <!-- Athletic Sports Tag -->
        <div class="hero-badge inline-flex items-center gap-2.5 px-4 py-1.5 rounded-lg bg-teal-500/15 border-l-4 border-teal-400 text-teal-300 text-xs sm:text-sm font-black tracking-widest uppercase mb-5">
          <span class="text-white font-mono text-xs">DVC // LIMA</span>
          <span class="text-teal-400">•</span>
          <span>SEDE COLEGIO FANNING • JESÚS MARÍA</span>
        </div>

        <!-- Heavy Sports Display Headline -->
        <h1 class="font-display uppercase tracking-tight text-white text-5xl sm:text-6xl md:text-7xl xl:text-8xl font-black leading-[0.9] mb-6">
          <span class="hero-title-line block sports-italic">FUERZA, SALTO</span>
          <span class="hero-title-line block text-gradient-neon sports-italic">Y CORAZÓN</span>
          <span class="hero-title-line block text-3xl sm:text-4xl md:text-5xl font-extrabold text-teal-300 mt-2 tracking-normal">
            EN CADA REMATE Y BLOQUEO
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-desc text-slate-200 text-base sm:text-lg md:text-xl max-w-2xl font-normal leading-relaxed mb-8 drop-shadow">
          El club donde la disciplina se convierte en potencia. Entrenamientos intensivos de vóley formativo, juvenil, libre para adultos y alta competencia en la mejor losa deportiva de Jesús María.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-8">
          <button 
            data-open-modal
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-teal-400 via-teal-300 to-emerald-400 text-[#040f18] font-black text-sm uppercase tracking-wider hover:from-teal-300 hover:to-emerald-300 transition-all duration-300 shadow-2xl shadow-teal-500/40 hover:shadow-teal-400/60 hover:-translate-y-0.5 cursor-pointer flex items-center justify-center gap-3"
          >
            <span class="text-base">🏐</span>
            <span>¡Quiero Probar una Clase!</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <a 
            href="#fundamentos" 
            class="w-full sm:w-auto px-7 py-4 rounded-xl card-glass text-white font-bold text-sm uppercase tracking-wider hover:text-teal-300 transition-all duration-300 border border-teal-500/30 hover:border-teal-400/60 flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
            <span>Ver Fundamentos de Juego</span>
          </a>
        </div>

        <!-- Athletic Feature Badges -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-bold text-slate-300">
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-[#081b29] border border-teal-500/30">
            <span class="text-teal-400">✓</span> Balones Oficiales Mikasa / Molten
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-[#081b29] border border-teal-500/30">
            <span class="text-teal-400">✓</span> Partidos Dirigidos cada Sesión
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-[#081b29] border border-teal-500/30">
            <span class="text-teal-400">✓</span> Todas las Edades (6 a 50+)
          </span>
        </div>

      </div>

      <!-- Right Column: Crest Emblem & Athletic Tactical Board -->
      <div class="lg:col-span-5 flex items-center justify-center relative">
        <div class="hero-crest-container relative w-72 sm:w-88 md:w-96 aspect-square flex items-center justify-center">
          
          <!-- Outer Pulsing Rings -->
          <div class="absolute inset-0 rounded-full border-2 border-teal-400/25 animate-spin" style="animation-duration: 35s;"></div>
          <div class="absolute inset-6 rounded-full border border-dashed border-teal-300/40 animate-spin" style="animation-duration: 20s; animation-direction: reverse;"></div>
          <div class="absolute inset-0 bg-radial-glow rounded-full filter blur-2xl opacity-70"></div>

          <!-- Official Crest -->
          <div class="hero-crest-float relative z-10 w-64 sm:w-76 md:w-80 aspect-square rounded-full p-2.5 bg-gradient-to-br from-teal-400/50 via-[#0b496d]/70 to-[#040f18] backdrop-blur-md border-2 border-teal-400/60 shadow-2xl shadow-teal-900/60">
            <div class="w-full h-full rounded-full overflow-hidden bg-[#051a27] p-1 flex items-center justify-center relative">
              <img 
                src="/images/logo.png" 
                alt="Escudo Oficial Domus Voleibol Club DVC" 
                class="w-full h-full object-contain filter drop-shadow-[0_12px_24px_rgba(0,0,0,0.7)]"
              />
              <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-transparent to-white/15 rounded-full pointer-events-none"></div>
            </div>
          </div>

          <!-- Tactical HUD Badge 1 (Top Left) -->
          <div class="absolute -top-4 -left-4 sm:-left-8 card-sport rounded-2xl px-4 py-3 shadow-2xl border border-teal-400/40 flex items-center gap-3 animate-sports-float z-20">
            <div class="w-10 h-10 rounded-xl bg-teal-500/20 text-teal-300 flex items-center justify-center text-lg font-black font-display">
              01
            </div>
            <div>
              <p class="text-[10px] uppercase font-black text-teal-400 tracking-wider">Técnica Especializada</p>
              <p class="text-xs font-extrabold text-white">Ataque, Salto & Bloqueo</p>
            </div>
          </div>

          <!-- Tactical HUD Badge 2 (Bottom Right) -->
          <div class="absolute -bottom-6 -right-2 sm:-right-6 card-sport rounded-2xl px-4 py-3 shadow-2xl border border-teal-400/40 flex items-center gap-3 animate-sports-float z-20" style="animation-delay: -2.5s;">
            <div class="w-10 h-10 rounded-xl bg-teal-500/20 text-teal-300 flex items-center justify-center text-lg font-black font-display">
              5-1
            </div>
            <div>
              <p class="text-[10px] uppercase font-black text-teal-400 tracking-wider">Táctica en Cancha</p>
              <p class="text-xs font-extrabold text-white">Sistemas & Rotaciones</p>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="mt-14 sm:mt-20 pt-8 border-t border-teal-500/20 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      
      <div class="hero-stat-card card-sport rounded-2xl p-5 text-center border border-teal-500/25">
        <p class="font-display text-4xl sm:text-5xl font-black text-white text-gradient-neon stat-counter" data-target="500" data-suffix="+">
          0
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-slate-300 uppercase tracking-widest mt-1">
          Alumnos Formados
        </p>
      </div>

      <div class="hero-stat-card card-sport rounded-2xl p-5 text-center border border-teal-500/25">
        <p class="font-display text-4xl sm:text-5xl font-black text-teal-300 stat-counter" data-target="4" data-suffix=" Categorías">
          0
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-slate-300 uppercase tracking-widest mt-1">
          Niveles de Juego
        </p>
      </div>

      <div class="hero-stat-card card-sport rounded-2xl p-5 text-center border border-teal-500/25">
        <p class="font-display text-4xl sm:text-5xl font-black text-white text-gradient-neon stat-counter" data-target="100" data-suffix="%">
          0
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-slate-300 uppercase tracking-widest mt-1">
          Pasión en Cancha
        </p>
      </div>

      <div class="hero-stat-card card-sport rounded-2xl p-5 text-center border border-teal-500/25">
        <p class="font-display text-4xl sm:text-5xl font-black text-teal-300 stat-counter" data-target="6" data-suffix=" Días">
          0
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-slate-300 uppercase tracking-widest mt-1">
          Turnos Semanales
        </p>
      </div>

    </div>

  </div>

  <!-- SPORTS MARQUEE TICKER (Continuous Ticker) -->
  <div class="w-full bg-gradient-to-r from-teal-500 via-teal-400 to-emerald-400 text-[#040f18] py-2.5 overflow-hidden font-display text-lg sm:text-xl font-black uppercase tracking-wider shadow-lg mt-10">
    <div class="animate-marquee whitespace-nowrap flex items-center">
      <span class="mx-4">🏐 DOMUS VOLEIBOL CLUB</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">SEDE COLEGIO TERESA GONZÁLEZ DE FANNING</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">JESÚS MARÍA, LIMA</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">SEMILLERO • MENORES • JUVENIL • ADULTOS LIBRE • COMPETITIVO</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">INFORMES & MATRÍCULAS: 979 833 360</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">PASIÓN, TÉCNICA Y DISCIPLINA</span>
      <span class="mx-4">✦</span>
      <!-- Duplicate for infinite seamless scroll -->
      <span class="mx-4">🏐 DOMUS VOLEIBOL CLUB</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">SEDE COLEGIO TERESA GONZÁLEZ DE FANNING</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">JESÚS MARÍA, LIMA</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">SEMILLERO • MENORES • JUVENIL • ADULTOS LIBRE • COMPETITIVO</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">INFORMES & MATRÍCULAS: 979 833 360</span>
      <span class="mx-4">✦</span>
      <span class="mx-4">PASIÓN, TÉCNICA Y DISCIPLINA</span>
      <span class="mx-4">✦</span>
    </div>
  </div>

</section>
