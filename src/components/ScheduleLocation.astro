---
// ScheduleLocation.astro - Training schedule and location details
---

<section id="horarios" class="py-20 md:py-32 relative bg-[#071926]/80 overflow-hidden">
  <!-- Glowing ambient light -->
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-teal-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="section-header text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <span class="text-teal-400 text-xs sm:text-sm font-bold uppercase tracking-widest inline-block mb-3">
        // ENTRENAMIENTOS & UBICACIÓN
      </span>
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-black uppercase text-white leading-tight mb-5">
        Horarios y <span class="text-gradient">Nuestra Sede</span>
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Clases programadas durante la semana y fines de semana en una ubicación céntrica y de fácil acceso en Jesús María.
      </p>
    </div>

    <!-- 2 Column Layout: Timetable on Left, Venue Info on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Timetable Cards -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <!-- Shift 1: Lunes, Miércoles y Viernes -->
        <div class="schedule-card card-glass rounded-3xl p-6 sm:p-8 border border-teal-500/25 relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-teal-500/20 flex-wrap gap-2">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-teal-400 animate-pulse"></span>
              <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white tracking-wide">
                Lunes • Miércoles • Viernes
              </h3>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30">
              Turno Tarde / Noche
            </span>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Semillero & Iniciación (6 a 12 años)</p>
                <p class="text-xs text-slate-400">Desarrollo motor y fundamentos básicos</p>
              </div>
              <span class="font-display text-lg font-bold text-teal-400 tracking-wider">4:00 PM - 5:30 PM</span>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Menores & Juveniles (13 a 17 años)</p>
                <p class="text-xs text-slate-400">Técnica intensiva, remate y recepción</p>
              </div>
              <span class="font-display text-lg font-bold text-teal-400 tracking-wider">5:30 PM - 7:00 PM</span>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-teal-500/30">
              <div>
                <p class="text-sm font-bold text-white">Mayores & Adultos (Libre Mixto)</p>
                <p class="text-xs text-slate-400">Acondicionamiento físico y partidos dirigidos</p>
              </div>
              <span class="font-display text-lg font-bold text-teal-300 tracking-wider">7:00 PM - 9:00 PM</span>
            </div>
          </div>
        </div>

        <!-- Shift 2: Martes y Jueves -->
        <div class="schedule-card card-glass rounded-3xl p-6 sm:p-8 border border-teal-500/25 relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-teal-500/20 flex-wrap gap-2">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-sky-400"></span>
              <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white tracking-wide">
                Martes • Jueves
              </h3>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/30">
              Intermedio / Libre
            </span>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Formativo Menores</p>
                <p class="text-xs text-slate-400">Corrección técnica y saques</p>
              </div>
              <span class="font-display text-lg font-bold text-sky-400 tracking-wider">5:00 PM - 6:30 PM</span>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Adultos Principiante & Intermedio</p>
                <p class="text-xs text-slate-400">Dinámicas grupales y juego guiado</p>
              </div>
              <span class="font-display text-lg font-bold text-sky-400 tracking-wider">6:30 PM - 8:30 PM</span>
            </div>
          </div>
        </div>

        <!-- Shift 3: Fines de Semana -->
        <div class="schedule-card card-glass rounded-3xl p-6 sm:p-8 border border-teal-500/25 relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-teal-500/20 flex-wrap gap-2">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white tracking-wide">
                Sábados & Domingos
              </h3>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
              Turno Mañana
            </span>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Semillero y Menores Sabatino</p>
                <p class="text-xs text-slate-400">Clases matutinas de fin de semana</p>
              </div>
              <span class="font-display text-lg font-bold text-amber-400 tracking-wider">9:00 AM - 11:00 AM</span>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-[#05131d]/70 border border-slate-800">
              <div>
                <p class="text-sm font-bold text-white">Competitivo & Torneos Relámpago</p>
                <p class="text-xs text-slate-400">Entrenamiento táctico y partidos de liga</p>
              </div>
              <span class="font-display text-lg font-bold text-amber-400 tracking-wider">11:00 AM - 1:00 PM</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Sede Details & Map Info -->
      <div class="lg:col-span-5 flex flex-col justify-between card-glass rounded-3xl p-6 sm:p-8 border-2 border-teal-500/30">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-teal-500/20 text-teal-300 flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase font-bold text-teal-400 tracking-wider">Sede Oficial</span>
              <h3 class="font-display text-2xl sm:text-3xl font-black text-white leading-tight">
                Colegio Teresa González de Fanning
              </h3>
            </div>
          </div>

          <!-- Court Photo -->
          <div class="relative rounded-2xl overflow-hidden aspect-video border border-teal-500/20 mb-6 shadow-lg">
            <img 
              src="/images/court-ball.jpg" 
              alt="Cancha de voleibol sede Fanning" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#05131d]/90 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 flex items-center gap-2 text-xs font-semibold text-white">
              <span class="w-2 h-2 rounded-full bg-teal-400"></span>
              <span>Canchas reglamentarias e iluminadas</span>
            </div>
          </div>

          <!-- Location Information Details -->
          <div class="space-y-4 mb-8 text-sm">
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 text-teal-400 shrink-0 mt-0.5">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="font-bold text-white">Dirección:</p>
                <p class="text-slate-300 text-xs sm:text-sm">Jr. Huamachuco (altura Av. Brasil / Metro de Jesús María), Jesús María, Lima, Perú.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 text-teal-400 shrink-0 mt-0.5">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="font-bold text-white">Informes & WhatsApp:</p>
                <a href="https://wa.me/51979833360" target="_blank" class="text-teal-300 hover:text-teal-200 font-semibold underline text-xs sm:text-sm">
                  +51 979 833 360
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 text-teal-400 shrink-0 mt-0.5">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="font-bold text-white">Seguridad & Servicios:</p>
                <p class="text-slate-300 text-xs sm:text-sm">Control de acceso en portería, vestidores, servicios higiénicos y tribunas para padres de familia.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <a 
            href="https://maps.google.com/?q=Colegio+Teresa+González+de+Fanning+Jesus+Maria+Lima" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-3.5 px-4 rounded-xl card-glass border border-teal-500/30 hover:border-teal-400 text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Ver Ubicación en Google Maps</span>
          </a>

          <button 
            data-open-modal
            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-teal-500 to-teal-400 hover:from-teal-400 hover:to-teal-300 text-[#05131d] font-extrabold text-xs uppercase tracking-wider transition-all duration-200 shadow-lg shadow-teal-500/25 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Consultar Disponibilidad de Vacantes</span>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>
