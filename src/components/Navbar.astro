---
// Navbar.astro - Header and Navigation
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative w-12 h-12 rounded-full overflow-hidden border-2 border-teal-400/40 p-0.5 bg-[#0a1f2e] transition-transform duration-300 group-hover:scale-105 group-hover:border-teal-400 shadow-md shadow-teal-500/20">
        <img 
          src="/images/logo.png" 
          alt="Domus Voleibol Club Logo" 
          class="w-full h-full object-cover rounded-full"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-display text-2xl sm:text-3xl font-bold tracking-wider text-white leading-none group-hover:text-teal-400 transition-colors">
          DOMUS
        </span>
        <span class="text-[10px] tracking-widest uppercase font-semibold text-teal-400/90 -mt-0.5">
          Voleibol Club
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 bg-[#0a1f2e]/80 border border-teal-500/20 rounded-full px-5 py-2 backdrop-blur-md shadow-lg shadow-black/40">
      <a href="#inicio" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Inicio
      </a>
      <a href="#fundamentos" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Fundamentos
      </a>
      <a href="#nosotros" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        El Club
      </a>
      <a href="#categorias" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Categorías
      </a>
      <a href="#metodologia" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Beneficios
      </a>
      <a href="#horarios" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Horarios & Sede
      </a>
      <a href="#galeria" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Galería
      </a>
      <a href="#faq" class="text-xs lg:text-sm font-medium text-slate-200 hover:text-teal-400 px-3 py-1.5 rounded-full transition-colors">
        Preguntas
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="hidden md:flex items-center gap-3">
      <a 
        href="/" 
        class="px-3.5 py-1.5 rounded-full border border-teal-400/40 text-teal-300 hover:text-white hover:bg-teal-500/20 text-xs font-bold transition-all shadow-sm flex items-center gap-1.5"
        title="Ir a la versión Pro interactiva"
      >
        <span>✨ Versión Pro</span>
      </a>

      <a 
        href="https://www.instagram.com/domus.voleibol.club/?hl=es" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Instagram de Domus Voleibol Club"
        class="p-2.5 rounded-full text-slate-300 hover:text-teal-300 bg-[#0a1f2e]/80 border border-teal-500/20 hover:border-teal-400/50 transition-all duration-200 hover:scale-105"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
        </svg>
      </a>

      <button 
        data-open-modal
        class="bg-gradient-to-r from-teal-500 to-teal-400 hover:from-teal-400 hover:to-teal-300 text-[#05131d] font-bold text-xs lg:text-sm px-5 py-2.5 rounded-full transition-all duration-200 shadow-md shadow-teal-500/25 hover:shadow-teal-400/40 hover:scale-105 cursor-pointer flex items-center gap-2"
      >
        <span>Inscríbete Ahora</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <button 
        data-open-modal
        class="bg-teal-500 hover:bg-teal-400 text-[#05131d] font-bold text-xs px-3.5 py-1.5 rounded-full transition-all"
      >
        Inscribirme
      </button>

      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="p-2 text-slate-300 hover:text-white bg-[#0a1f2e] border border-teal-500/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-400"
        aria-label="Abrir menú de navegación"
      >
        <!-- Hamburger Icon -->
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon -->
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden fixed inset-x-4 top-20 bg-[#0a1f2e]/98 border border-teal-500/30 rounded-2xl p-6 backdrop-blur-xl shadow-2xl transition-all duration-300 flex-col gap-4 z-50 max-h-[85vh] overflow-y-auto"
  >
    <div class="flex items-center gap-3 pb-4 border-b border-teal-500/20">
      <img src="/images/logo.png" alt="Domus Logo" class="w-10 h-10 rounded-full" />
      <div>
        <p class="font-display text-xl font-bold text-white leading-tight">DOMUS VOLEIBOL CLUB</p>
        <p class="text-xs text-teal-400">Jesús María, Lima</p>
      </div>
    </div>

    <nav class="flex flex-col gap-2">
      <a href="#inicio" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Inicio
      </a>
      <a href="#fundamentos" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Fundamentos del Vóley
      </a>
      <a href="#nosotros" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        El Club & Filosofía
      </a>
      <a href="#categorias" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Categorías de Entrenamiento
      </a>
      <a href="#metodologia" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Metodología & Beneficios
      </a>
      <a href="#horarios" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Horarios & Sede Fanning
      </a>
      <a href="#galeria" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Galería de Fotos
      </a>
      <a href="#faq" class="mobile-nav-link text-slate-200 hover:text-teal-400 font-medium py-2 px-3 rounded-lg hover:bg-teal-500/10 transition-colors">
        Preguntas Frecuentes
      </a>
    </nav>

    <div class="pt-4 border-t border-teal-500/20 flex flex-col gap-3">
      <button 
        data-open-modal
        class="w-full bg-gradient-to-r from-teal-500 to-teal-400 text-[#05131d] font-bold py-3 rounded-xl shadow-lg shadow-teal-500/25 flex items-center justify-center gap-2"
      >
        <span>Solicitar Información / Matrícula</span>
      </button>

      <a 
        href="/" 
        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-teal-400/50 text-teal-300 bg-teal-500/10 hover:bg-teal-500/20 text-sm font-bold transition-colors"
      >
        <span>✨ Ver Versión Pro V2</span>
      </a>

      <a 
        href="https://www.instagram.com/domus.voleibol.club/?hl=es" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-teal-500/30 text-teal-300 hover:bg-teal-500/10 text-sm font-semibold transition-colors"
      >
        <span>Seguir en Instagram @domus.voleibol.club</span>
      </a>
    </div>
  </div>
</header>
