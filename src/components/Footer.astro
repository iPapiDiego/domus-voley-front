---
// Footer.astro - Club Footer & Social Links
---

<footer class="bg-[#030d14] border-t border-teal-500/20 pt-16 pb-12 text-slate-400 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-slate-800">
      
      <!-- Brand & Summary -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <div class="flex items-center gap-3.5 mb-5">
          <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-teal-400 p-0.5 bg-[#0a1f2e] shadow-lg shadow-teal-500/20">
            <img src="/images/logo.png" alt="Domus Voleibol Club Logo" class="w-full h-full object-cover rounded-full" />
          </div>
          <div>
            <span class="font-display text-3xl font-bold tracking-wider text-white leading-none block">
              DOMUS VOLEIBOL CLUB
            </span>
            <span class="text-xs uppercase tracking-widest text-teal-400 font-semibold">
              Jesús María • Lima, Perú
            </span>
          </div>
        </div>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm mb-6">
          Academia y club formativo de voleibol. Fomentamos el deporte, la vida sana, el compañerismo y la competencia de alto nivel para todas las edades.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/domus.voleibol.club/?hl=es" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Instagram de Domus Voleibol Club"
            class="w-10 h-10 rounded-xl bg-[#0a1f2e] border border-teal-500/30 text-teal-400 hover:text-white hover:bg-gradient-to-tr hover:from-pink-500 hover:to-purple-600 hover:border-transparent flex items-center justify-center transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>

          <!-- WhatsApp -->
          <a 
            href="https://wa.me/51979833360" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="WhatsApp Domus Voley"
            class="w-10 h-10 rounded-xl bg-[#0a1f2e] border border-teal-500/30 text-teal-400 hover:text-white hover:bg-emerald-600 hover:border-transparent flex items-center justify-center transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Navegación</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#inicio" class="hover:text-teal-400 transition-colors">Inicio</a></li>
          <li><a href="#nosotros" class="hover:text-teal-400 transition-colors">El Club & Filosofía</a></li>
          <li><a href="#categorias" class="hover:text-teal-400 transition-colors">Categorías de Entrenamiento</a></li>
          <li><a href="#metodologia" class="hover:text-teal-400 transition-colors">Beneficios & Metodología</a></li>
          <li><a href="#horarios" class="hover:text-teal-400 transition-colors">Horarios & Sede Fanning</a></li>
          <li><a href="#galeria" class="hover:text-teal-400 transition-colors">Galería</a></li>
          <li><a href="#faq" class="hover:text-teal-400 transition-colors">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Contact & Venue -->
      <div class="lg:col-span-4">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Contacto & Sede</h4>
        <div class="space-y-3 text-sm">
          <p class="flex items-start gap-2.5">
            <span class="text-teal-400 font-bold shrink-0">📍</span>
            <span><strong>Sede Fanning:</strong> Colegio Teresa González de Fanning, Jr. Huamachuco, Jesús María, Lima.</span>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="text-teal-400 font-bold shrink-0">📱</span>
            <span><strong>WhatsApp / Informes:</strong> <a href="https://wa.me/51979833360" class="text-teal-300 hover:underline">+51 979 833 360</a></span>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="text-teal-400 font-bold shrink-0">📸</span>
            <span><strong>Instagram:</strong> <a href="https://www.instagram.com/domus.voleibol.club/?hl=es" target="_blank" class="text-teal-300 hover:underline">@domus.voleibol.club</a></span>
          </p>
        </div>
      </div>

    </div>

    <!-- Copyright Subfooter -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} Domus Voleibol Club. Todos los derechos reservados.</p>
      <p class="text-slate-400">Pasión, Técnica y Disciplina en Cada Jugada 🏐</p>
    </div>

  </div>
</footer>
