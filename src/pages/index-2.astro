---
import Layout from '../layouts/Layout.astro';
import NavbarV2 from '../components/v2/NavbarV2.astro';
import HeroV2 from '../components/v2/HeroV2.astro';
import TacticalBoardV2 from '../components/v2/TacticalBoardV2.astro';
import BentoExperienceV2 from '../components/v2/BentoExperienceV2.astro';
import CategoryMatrixV2 from '../components/v2/CategoryMatrixV2.astro';
import MembershipCalculatorV2 from '../components/v2/MembershipCalculatorV2.astro';
import ActionGalleryV2 from '../components/v2/ActionGalleryV2.astro';
import InstagramFeedV2 from '../components/v2/InstagramFeedV2.astro';
import TestimonialsV2 from '../components/v2/TestimonialsV2.astro';
import FaqV2 from '../components/v2/FaqV2.astro';
import CtaBannerV2 from '../components/v2/CtaBannerV2.astro';
import FooterV2 from '../components/v2/FooterV2.astro';
import ModalV2 from '../components/v2/ModalV2.astro';
import FloatingWhatsappV2 from '../components/v2/FloatingWhatsappV2.astro';
---

<Layout 
  title="Domus Voleibol Club Index 2 | Academia Oficial en Jesús María, Lima"
  description="Landing Index 2 Pro de Domus Voleibol Club en el Colegio Teresa González de Fanning y Colegio Joseph and Mary (Jesús María, Lima). Pizarra táctica interactiva, cotizador de matrícula, fotos de Instagram y clases de prueba gratis."
>
  <NavbarV2 />
  
  <main class="relative bg-[#03131e] overflow-hidden w-full max-w-full">
    <HeroV2 />
    <TacticalBoardV2 />
    <BentoExperienceV2 />
    <CategoryMatrixV2 />
    <MembershipCalculatorV2 />
    <ActionGalleryV2 />
    <InstagramFeedV2 />
    <TestimonialsV2 />
    <FaqV2 />
    <CtaBannerV2 />
  </main>

  <FooterV2 />
  <ModalV2 />
  <FloatingWhatsappV2 />

  <!-- Strictly separated client JavaScript architecture -->
  <script src="../scripts/v2/main.js"></script>
</Layout>
